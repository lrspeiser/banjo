# Local credentials
.env
.env.*
!.env.example

# Fast-gpu lane recordings are runtime artifacts (up to 64 MiB each); the reports next to them are kept.
docs/evidence/fast-gpu/*.playback.json
# The criterion lane's recordings likewise: 4-30 MiB each, regenerated by
# `python scripts/criterion-ladder.py --stage record`.
docs/evidence/criterion/*.playback.json
# Re-fracture lane recordings, likewise; the reports next to them are kept and
# are regenerated by `python scripts/refracture-scenes.py`.
docs/evidence/refracture/*.playback.json

# A live world writes the scene it was opened with into a directory per session,
# so the engine can be handed a file. They are scratch: the scene is rebuilt
# from the panel every time one opens.
playground/runs/
