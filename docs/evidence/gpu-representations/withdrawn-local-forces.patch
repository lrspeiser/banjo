+extern "C" __global__ void local_force_jacobian(const double *bodies,const double *edges,unsigned edge_count,
+    const unsigned *jobs,unsigned rows,const unsigned *offsets,const unsigned *incidence,
+    const int *dynamic,unsigned count,const double *epsilon,const double *wrenches,
+    const unsigned char *active,double h,double *matrix){
+    const unsigned k=blockDim.x*blockIdx.x+threadIdx.x;if(k>=count*count)return;
+    const unsigned i=k/count,j=k%count,coordinate=dynamic[i],body=coordinate/6,column=coordinate%6;
+    const unsigned changed=dynamic[j]/6;double derivative=0;
+    // Each constitutive/contact force depends only on its two endpoints.
+    // Difference those forces BEFORE unrelated contributions are added.
+    // The inertia derivative is exactly the identity in weighted coordinates.
+    // No force/history response or accepted residual is approximated here.
+    for(unsigned p=offsets[body];p<offsets[body+1];++p){
+        const unsigned code=incidence[p],row=code/2,side=code%2;unsigned a,b;
+        if(row<edge_count){a=static_cast<unsigned>(edges[70*row]);b=static_cast<unsigned>(edges[70*row+1]);}
+        else{a=jobs[4*(row-edge_count)];b=jobs[4*(row-edge_count)+1];}
+        if(a!=changed&&b!=changed)continue;
+        const unsigned plus=j*rows+row,minus=(count+j)*rows+row;
+        const double fp=active[plus]?wrenches[12*plus+6*side+column]:0;
+        const double fm=active[minus]?wrenches[12*minus+6*side+column]:0;
+        derivative+=(fp-fm)/(2*epsilon[j]);
+    }
+    const double *b=bodies+30*body,root=sqrt(column<3?b[1]:b[2]);
+    matrix[k]=(i==j?1:0)-h*derivative/root;
+}
