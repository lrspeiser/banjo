    "script": "import sys,json,inspect,textwrap,time\nfrom pathlib import Path\nsys.path.insert(0,'scripts')\nimport cupy as cp,numpy as np\nimport gpu_coupled_world as module\nbase=textwrap.dedent(inspect.getsource(module.CoupledEvaluator.solve));solvers=[]\nfractions=(1.,.1,.01)\nfor fraction in fractions:\n source=base.replace('y=original[self.dynamic]*self.active_weights',f'y=({2*fraction}-1)*original[self.dynamic]*self.active_weights')\n scope=dict(vars(module));exec(source,scope);solvers.append(scope['solve'])\ndef bounded(self,h,gravity=-9.81,maximum_iterations=24):\n used=0;v=cp.broadcast_to(self.bodies[:,14:20],(3,self.n,6)).copy();v*=cp.asarray([2*f-1 for f in fractions])[:,None,None]\n probes=self.evaluate(v,h,gravity);norms=cp.linalg.norm(probes['residual'].reshape(3,-1)[:,self.dynamic],axis=1)\n norms=cp.where(probes['faults']==0,norms,cp.inf);order=cp.asnumpy(cp.argsort(norms,kind='stable'))\n for index in order:\n  if used>=maximum_iterations:break\n  try:\n   result,velocity,iterations,norm=solvers[index](self,h,gravity,maximum_iterations-used)\n   return result,velocity,used+iterations,norm\n  except module.TrialFailure as error:\n   used+=len(error.details.get('iterations',[])) or 1;last=error\n raise last\nmodule.CoupledEvaluator.solve=bounded\nresult=dict(algorithm='Private residual-ranked bounded three-start Newton; total iteration limit stays 24; physical laws and gates unchanged',comparisons=[])\nfor material in ('glass','oak','iron','ice'):\n w=module.GpuCoupledWorld(dict(material=material,ball_mass_kg=.1,height_m=.005,dt_s=1/960));started=time.perf_counter()\n for tick in range(100):\n  try:w.advance(1)\n  except RuntimeError:break\n  if (tick+1)%20==0:print(material,'tick',tick+1,'wall',time.perf_counter()-started,flush=True)\n s=w.snapshot();row=dict(material=material,wall_s=time.perf_counter()-started,state=s);result['comparisons'].append(row)\n print(material,s['time_s'],row['wall_s'],'steps',s['performance']['microsteps'],'iterations',s['performance']['nonlinear_iterations'],'separated',s['diagnostics']['separated_sites'],'E',s['diagnostics']['global_energy_residual_j'],'failure',s.get('rejected_candidate',{}).get('error'),flush=True)\n Path('build/gpu-contact-convergence/ranked-world.json').write_text(json.dumps(result,indent=2)+'\\n',encoding='utf8')\n",
