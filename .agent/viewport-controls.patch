@@ -122,0 +123,12 @@ body.workshop-mode > :not(#design-workshop) { display:none!important; }
+
+/* Run and measured results stay visible while the parameter sidebar scrolls. */
+.ws-simulation-dock { position:absolute;left:1rem;top:4rem;z-index:3;
+  max-width:min(470px,calc(100% - 2rem));max-height:calc(100% - 6rem);overflow:auto;
+  box-sizing:border-box;display:grid;gap:.4rem;padding:.65rem .8rem;border-radius:.5rem;
+  border:1px solid #465363;background:#0b1017ed;color:#e7edf4;font-size:.78rem; }
+.ws-simulation-dock[hidden] { display:none; }
+.ws-simulation-dock p { margin:.35rem 0;line-height:1.35; }
+.ws-simulation-dock .ws-note { margin:0;padding:.4rem;border:0; }
+.ws-simulation-dock .ws-row { margin:.35rem 0; }
+.ws-simulation-dock #ws-run-bench { justify-self:start;font-weight:700; }
+.ws-simulation-dock #ws-play-timeline { width:100%; }
